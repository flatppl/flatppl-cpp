FUNCTION = re.compile(
    r"^\s*func\.func @([a-zA-Z_]\w*)\s*\(([^()]*)\)"
    r"(?:\s*->\s*(\([^()]*\)|tensor<[^<>]+>))?\s*\{",
    re.MULTILINE,
)
TENSOR = re.compile(r"tensor<((?:[0-9]+x|\?x)*)(f32|f64|i32|i64|ui64|i1)>")


@dataclass(frozen=True)
class Leaf:
    name: str
    scalar: str | None
    count: str | None = None


@dataclass(frozen=True)
class Tensor:
    dtype: str
    shape: tuple[int, ...]


def identifier(name):
    result = re.sub(r"[^a-zA-Z0-9]+", "_", name).strip("_") or "field"
    if result[0].isdigit() or result in CPP_KEYWORDS:
        return "fp_" + result
    return result


def tag(node, name):
    return isinstance(node, list) and bool(node) and node[0] == name


def node_meta(node):
    return node.get("%meta", {}) if isinstance(node, dict) else {}


def unwrap(node):
    return node_meta(node).get("expr", node)


def reference(node):
    node = unwrap(node)
    if isinstance(node, dict):
        ref = node.get("%ref", {})
        if ref.get("ns") == "self":
            return ref["name"]
    return None


def signature_entries(node):
    node = unwrap(node)
    if tag(node, "tuple"):
        return node[1:]
    return [] if node is None else [node]


def scalar_kind(typ):
    while isinstance(typ, list) and typ and typ[0] in ("%array", "%tvector"):
        typ = typ[-1]
    if tag(typ, "%scalar"):
        return typ[1]["const"]
    return None


def flatten(typ, expr, prefix, bindings, count=None):
    if typ is None:
        typ = node_meta(expr).get("type")
    ref = reference(expr)
    if ref in bindings:
        target = bindings[ref]
        return flatten(typ, target, prefix or ref, bindings, count)
    expr = unwrap(expr)
    if typ is not None and (tag(typ, "%record") or tag(typ, "%table")):
        fields = typ[1:] if typ[0] == "%record" else typ[1][1:]
        return [
            leaf
            for name, field_type in fields
            for leaf in flatten(
                field_type,
                None,
                f"{prefix}.{name}" if prefix else name,
                bindings,
                count,
            )
        ]
    if tag(typ, "%tuple") or tag(expr, "tuple"):
        types = (
            typ[1:]
            if typ is not None and tag(typ, "%tuple")
            else [None] * (len(expr) - 1)
        )
        values = expr[1:] if tag(expr, "tuple") else [None] * len(types)
        return [
            leaf
            for i, (kind, item) in enumerate(zip(types, values), 1)
            for leaf in flatten(
                kind, item, f"{prefix or 'result'}.{i}", bindings, count
            )
        ]
    return [Leaf(prefix or "result", scalar_kind(typ), count)]


def leading_count(expr, bindings):
    expr = unwrap(expr)
    if tag(expr, "external") and len(expr) >= 2:
        domain = unwrap(expr[1])
    elif tag(expr, "load_data") and len(expr) >= 3:
        domain = unwrap(expr[2])
    elif tag(expr, "elementof") and len(expr) >= 2:
        domain = unwrap(expr[1])
    else:
        target = reference(expr)
        return leading_count(bindings[target], bindings) if target in bindings else None
    if tag(domain, "cartpow") and len(domain) == 3:
        dimensions = unwrap(domain[2])
        if tag(dimensions, "vector"):
            return reference(dimensions[1]) if len(dimensions) > 1 else None
        return reference(dimensions)
    return None


def flatpir_signature(source):
    module = source["%module"]
    bindings = {binding["name"]: binding["expr"] for binding in module["binds"]}
    inputs = []
    for expr in signature_entries(bindings.get("inputs")):
        name = reference(expr)
        if name not in bindings:
            raise BuildError("each FlatPPL input must name a binding")
        binding = bindings[name]
        leaves = flatten(
            None, binding, name, bindings, leading_count(binding, bindings)
        )
        if not leaves:
            raise BuildError(f"{name}: input has no tensor fields")
        inputs.append((name, leaves))

    outputs = []
    expressions = signature_entries(bindings.get("outputs"))
    for i, expr in enumerate(expressions, 1):
        default = f"result_{i}" if len(expressions) > 1 else ""
        outputs.extend(flatten(None, expr, reference(expr) or default, bindings))
    return inputs, outputs


def parse_tensor(text):
    match = TENSOR.fullmatch(text.strip())
    if not match:
        raise BuildError(f"unsupported StableHLO tensor type {text.strip()!r}")
    dimensions, dtype = match.groups()
    shape = tuple(-1 if dim == "?" else int(dim) for dim in dimensions.split("x")[:-1])
    if any(dim > (1 << 63) - 1 for dim in shape):
        raise BuildError("tensor dimension exceeds int64")
    return Tensor(dtype, shape)


def stablehlo_signature(text):
    functions = list(FUNCTION.finditer(text))
    if len(functions) != 1:
        raise BuildError("expected one exported StableHLO function")
    name, arguments, results = functions[0].groups()
    inputs = [
        parse_tensor(item.split(":", 1)[1])
        for item in arguments.split(",")
        if item.strip()
    ]
    outputs = [
        parse_tensor(item)
        for item in (results or "").strip("()").split(",")
        if item.strip()
    ]
    status = re.search(r"\bflatppl\.runtime_status\s*=\s*(\d+)\s*:", text)
    status_bytes = 0
    if status:
        if int(status[1]) != len(outputs) - 1 or outputs[-1] not in (
            Tensor("i32", ()),
            Tensor("i64", ()),
        ):
            raise BuildError("unsupported FlatPPL runtime status result")
        status_bytes = 4 if outputs.pop().dtype == "i32" else 8
    return "module." + name, inputs, outputs, status_bytes


def match_fields(leaves, tensors, direction):
    if len(leaves) != len(tensors):
        raise BuildError(
            f"{direction}: FlatPIR has {len(leaves)} leaves, StableHLO has {len(tensors)} tensors"
        )
    used = set()
    for leaf, tensor in zip(leaves, tensors):
        scalar = TYPES[tensor.dtype][2]
        if leaf.scalar is not None and scalar is not None and scalar != leaf.scalar:
            raise BuildError(
                f"{leaf.name}: FlatPIR and StableHLO disagree about the element type"
            )
        name = identifier(leaf.name)
        if name in used:
            raise BuildError(f"{direction}: C++ field name {name!r} collides")
        used.add(name)
    return list(zip(leaves, tensors))


def cpp_type(tensor, container):
    element = TYPES[tensor.dtype][0]
    if tensor.shape:
        return f"flatppl::{container}<{element}, {len(tensor.shape)}>"
    return element


def cpp_arguments(input_groups, inputs):
    declarations = []
    parameters = []
    descriptors = []
    input_types = {leaf.name: tensor for leaf, tensor in inputs}
    used = set()
    for name, leaves in input_groups:
        parameter = identifier(name)
        if parameter in used:
            raise BuildError(f"inputs: C++ parameter name {parameter!r} collides")
        used.add(parameter)
        members = []
        for leaf in leaves:
            tensor = input_types[leaf.name]
            field = parameter
            if len(leaves) > 1:
                member = identifier(leaf.name[len(name) + 1 :])
                member_type = cpp_type(tensor, "TensorView")
                members.append(f"  {member_type} {member};")
                field = f"{parameter}.{member}"
            descriptors.append(
                f"{field}.descriptor()"
                if tensor.shape
                else f"::flatppl::scalar({field})"
            )
        if members:
            argument_type = f"Input_{parameter}"
            declarations.append(
                f"struct {argument_type} {{\n" + "\n".join(members) + "\n};\n"
            )
            parameters.append(f"const struct {argument_type}& {parameter}")
        else:
            argument_type = cpp_type(input_types[leaves[0].name], "TensorView")
            parameters.append(f"{argument_type} {parameter}")
    return (
        "\n".join(declarations),
        ", ".join(parameters),
        ",\n        ".join(descriptors),
    )


def cpp_header(name, symbol, input_groups, inputs, outputs):
    declarations, parameters, args = cpp_arguments(input_groups, inputs)
    fields_out = "\n".join(
        f"  {cpp_type(tensor, 'Tensor')} {identifier(leaf.name)};"
        for leaf, tensor in outputs
    )
    reads = []
    for index, (_, tensor) in enumerate(outputs):
        element = TYPES[tensor.dtype][0]
        reader = (
            f"read_tensor<{element}, {len(tensor.shape)}>"
            if tensor.shape
            else f"read_scalar<{element}>"
        )
        reads.append(f"::flatppl::{reader}(results_[{index}])")
    returns = ",\n        ".join(reads)
    return f"""#pragma once
#include "flatppl.hpp"

extern "C" const flatppl_model_api* {symbol}(void);

namespace flatppl::{name} {{

{declarations}struct Outputs {{
{fields_out}
}};

class Model {{
 public:
  static Model linked() {{
    return Model({symbol}(), {{}});
  }}

  static Model open(const char* path) {{
    flatppl::Library library(path);
    const auto* api = library.api("{symbol}");
    return Model(api, std::move(library));
  }}

  Outputs evaluate({parameters}) {{
    const std::array<flatppl_tensor, {len(inputs)}> input_tensors_ = {{{{
        {args}
    }}}};
    const auto* results_ =
        instance_.evaluate(input_tensors_.data(), input_tensors_.size());
    return {{
        {returns}
    }};
  }}

 private:
  Model(const flatppl_model_api* api, flatppl::Library library)
      : instance_(api, std::move(library)) {{}}

  flatppl::Instance instance_;
}};

}}  // namespace flatppl::{name}
"""


def c_fields(name, fields):
    declarations = []
    elements = []
    for index, (leaf, tensor) in enumerate(fields):
        shape = "NULL"
        if tensor.shape:
            shape = f"{name}_shape_{index}"
            dims = ", ".join(map(str, tensor.shape))
            declarations.append(f"static const int64_t {shape}[] = {{{dims}}};")
        elements.append(
            f"  {{{json.dumps(leaf.name)}, {TYPES[tensor.dtype][1]}, "
            f"{len(tensor.shape)}, {shape}}},"
        )
    entries = "\n".join(elements) if elements else "  {0},"
    return "\n".join(
        declarations + [f"static const flatppl_field {name}[] = {{", entries, "};"]
    )


def c_config(symbol, entry, inputs, outputs, status_bytes):
    max_rank = max([1] + [len(tensor.shape) for _, tensor in inputs + outputs])
    scalar_inputs = {
        leaf.name: i
        for i, (leaf, tensor) in enumerate(inputs)
        if not tensor.shape and tensor.dtype in ("i32", "i64")
    }
    extents = [
        scalar_inputs.get(leaf.count, -1)
        if tensor.shape and tensor.shape[0] == -1
        else -1
        for leaf, tensor in inputs
    ]
    counts = ", ".join(map(str, extents or [-1]))
    return f"""#define MODEL_SYMBOL {symbol}
#define MODEL_ENTRY_POINT {json.dumps(entry)}
#define INPUT_COUNT {len(inputs)}
#define OUTPUT_COUNT {len(outputs)}
#define MAX_RANK {max_rank}
#define MODEL_STATUS_BYTES {status_bytes}

{c_fields("input_fields", inputs)}
{c_fields("output_fields", outputs)}
static const int leading_extent_inputs[] = {{{counts}}};
"""


def embed(module, destination):
    with destination.open("w", encoding="ascii") as out, module.open("rb") as data:
        out.write("#include <stddef.h>\n\n")
        out.write("_Alignas(64) const unsigned char flatppl_module[] = {\n")
        while chunk := data.read(24):
            out.write("    " + ", ".join(f"0x{byte:02x}" for byte in chunk) + ",\n")
        out.write("};\nconst size_t flatppl_module_size = sizeof(flatppl_module);\n")


def build(args):
    out = args.out_dir.resolve()
    if not args.query.is_file():
        raise BuildError(f"query not found: {args.query}")
    if out.exists() and not out.is_dir():
        raise BuildError(f"output is not a directory: {out}")
    tool_cache = ROOT / ".build" / "toolchains"
    flatppl = flatppl_compiler(args.flatppl, args.fetch_flatppl, tool_cache)
    iree, iree_compile = iree_tools(args, tool_cache)
    name = identifier(args.name or args.query.stem)
    out.parent.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha256(os.fsencode(out)).hexdigest()[:16]
    cache = ROOT / ".build" / key
    with lock_directory(cache / "lock"):
        build_model(args, out, flatppl, iree, iree_compile, name, cache)


def build_model(args, out, flatppl, iree, iree_compile, name, cache):
    source = cache / "model"
    source.mkdir(exist_ok=True)
    query = args.query.resolve()
    inferred = source / "query.flatpir"
    flatpir = source / "query.flatpir.json"
    mlir = source / "query.mlir"
    vmfb = source / "query.vmfb"
    run([flatppl, "infer", query, inferred, "--no-header"], quiet=True)
    run([flatppl, "convert", inferred, flatpir, "--no-header"], quiet=True)
    options = ["--dtype", args.dtype] if args.dtype else []
    run(
        [
            flatppl,
            "stablehlo",
            query,
            "--restrict-enzyme-compatible=false",
            *options,
            "-o",
            mlir,
        ],
        quiet=True,
    )

    input_groups, output_leaves = flatpir_signature(json.loads(flatpir.read_text()))
    input_leaves = [leaf for _, group in input_groups for leaf in group]
    stablehlo = mlir.read_text()
    entry, input_tensors, output_tensors, status = stablehlo_signature(stablehlo)
    inputs = match_fields(input_leaves, input_tensors, "inputs")
    outputs = match_fields(output_leaves, output_tensors, "outputs")
    fingerprint = hashlib.sha256(repr((inputs, outputs, status)).encode()).hexdigest()[
        :16
    ]
    symbol = f"flatppl_query_{name}_{fingerprint}_api_v1"
    (source / "model_config.h").write_text(
        c_config(symbol, entry, inputs, outputs, status)
    )
    header = cpp_header(name, symbol, input_groups, inputs, outputs)

    iree_mlir = source / "query.iree.mlir"
    iree_mlir.write_text(apply_iree_workarounds(stablehlo))
    run(
        [
            iree_compile,
            iree_mlir,
            "--iree-input-type=stablehlo",
            "--iree-input-demote-f64-to-f32=false",
            "--iree-hal-target-device=local",
            "--iree-hal-local-target-device-backends=llvm-cpu",
            "--iree-llvmcpu-target-cpu=generic",
            "-o",
            vmfb,
        ],
        quiet=True,
    )
    embed(vmfb, source / "model_data.c")

    # Keep the IREE runtime objects across model builds using this checkout.
    runtime_key = hashlib.sha256(os.fsencode(iree)).hexdigest()[:16]
    cmake = cache.parent / "runtime" / runtime_key
    with lock_directory(cmake / "lock"):
        library, import_file = link_model(args, cmake, iree, source, name, symbol)
        publish(out, name, header, library, import_file)
    print(out / library.name)
    print(out / f"{name}.hpp")


def link_model(args, cmake, iree, source, name, symbol):
    run(
        [
            "cmake",
            "-S",
            ROOT,
            "-B",
            cmake,
            "-DCMAKE_BUILD_TYPE=Release",
            f"-DIREE_SOURCE={iree}",
            f"-DMODEL_SOURCE={source}",
            f"-DMODEL_NAME={name}",
            f"-DMODEL_SYMBOL={symbol}",
        ],
        quiet=True,
    )
    jobs = ["--parallel", str(args.jobs)] if args.jobs else []
    run(
        [
            "cmake",
            "--build",
            cmake,
            "--config",
            "Release",
            "--target",
            "flatppl_generated_model",
            *jobs,
        ],
        quiet=True,
    )
    library = Path((cmake / "artifact-Release.txt").read_text().strip())
    if library.suffix == ".dll":
        import_file = Path((cmake / "linker-Release.txt").read_text().strip())
    else:
        import_file = None
    return library, import_file


def cmake_package(name, library, import_file):
    target = f"flatppl::{name}"
    headers = f"{target}::headers"
    config = f"""if(TARGET {target})
  return()
endif()

add_library({headers} INTERFACE IMPORTED)
set_target_properties({headers} PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES "${{CMAKE_CURRENT_LIST_DIR}}"
  INTERFACE_COMPILE_FEATURES cxx_std_17
  INTERFACE_LINK_LIBRARIES "${{CMAKE_DL_LIBS}}")

add_library({target} SHARED IMPORTED)
set_target_properties({target} PROPERTIES
  IMPORTED_LOCATION "${{CMAKE_CURRENT_LIST_DIR}}/{library.name}"
  INTERFACE_LINK_LIBRARIES {headers})
"""
    if import_file:
        config += (
            f"set_property(TARGET {target} PROPERTY IMPORTED_IMPLIB\n"
            f'  "${{CMAKE_CURRENT_LIST_DIR}}/{import_file.name}")\n'
        )
    return config


def publish(out, name, header, library, import_file):
    out.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(dir=out) as temp:
        stage = Path(temp)
        (stage / f"{name}.hpp").write_text(header)
        (stage / f"{name}Config.cmake").write_text(
            cmake_package(name, library, import_file)
        )
        artifacts = [
            ROOT / "include" / "flatppl.h",
            ROOT / "include" / "flatppl.hpp",
            library,
        ]
        if import_file:
            artifacts.append(import_file)
        for path in artifacts:
            shutil.copy2(path, stage / path.name)
        for artifact in stage.iterdir():
            os.replace(artifact, out / artifact.name)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("query", type=Path)
    parser.add_argument("--out-dir", type=Path, required=True)
    flatppl = parser.add_mutually_exclusive_group(required=True)
    flatppl.add_argument("--flatppl", type=Path, help="local FlatPPL executable")
    flatppl.add_argument(
        "--fetch-flatppl", action="store_true", help="fetch and build pinned FlatPPL"
    )
    iree = parser.add_mutually_exclusive_group(required=True)
    iree.add_argument("--iree-dir", type=Path, help="local IREE source checkout")
    iree.add_argument(
        "--fetch-iree", action="store_true", help="fetch pinned IREE tools and source"
    )
    compiler = parser.add_mutually_exclusive_group()
    compiler.add_argument(
        "--iree-compile", type=Path, help="local IREE compiler executable"
    )
    compiler.add_argument(
        "--build-iree-from-source",
        action="store_true",
        help="build iree-compile and the linker from the selected IREE source",
    )
    parser.add_argument(
        "--dtype", choices=("f32", "f64"), help="default: use FlatPPL's default"
    )
    parser.add_argument("--name", help="name of the library and C++ namespace")
    parser.add_argument("--jobs", type=int, help="parallel CMake build jobs")
    args = parser.parse_args()
    if args.jobs is not None and args.jobs < 1:
        parser.error("--jobs must be positive")
    try:
        build(args)
    except (BuildError, OSError, ValueError, KeyError, BadZipFile) as error:
        parser.exit(1, f"flatppl-build: {error}\n")


if __name__ == "__main__":
    main()
